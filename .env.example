# Copy to .env and fill in. .env is gitignored.
FLEXISCHOOL_USERNAME=
FLEXISCHOOL_PASSWORD=
ANTHROPIC_API_KEY=

# Web chat (npm run web). See DEPLOY.md.
# Who may sign in: email=Display name, comma-separated.
ALLOWED_USERS=parent1@example.com=Parent1,parent2@example.com=Parent2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://school.example.com. Defaults to http://localhost:$PORT.
# PUBLIC_URL=
# PORT=8080
# Local only: sign in without Google (refused unless PUBLIC_URL is localhost).
# DEV_LOGIN=1
